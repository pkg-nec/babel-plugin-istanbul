{
  "name": "@pkg-nec/babel-plugin-istanbul",
  "version": "9.0.1",
  "author": "Thai Pangsakulyanont @dtinth",
  "license": "BSD-3-Clause",
  "description": "Security-maintained compatible fork of the Babel plugin for Istanbul code coverage instrumentation",
  "funding": "https://buymeacoffee.com/maw629",
  "main": "lib/index.js",
  "files": [
    "lib"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@babel/helper-plugin-utils": "^7.0.0",
    "@istanbuljs/load-nyc-config": "^1.0.0",
    "@istanbuljs/schema": "^0.1.3",
    "istanbul-lib-instrument": "^6.0.2",
    "test-exclude": "^8.0.0"
  },
  "devDependencies": {
    "@babel/cli": "^7.29.7",
    "@babel/core": "^7.29.7",
    "@babel/plugin-transform-block-scoping": "^7.29.7",
    "@babel/plugin-transform-modules-commonjs": "^7.29.7",
    "@babel/register": "^7.29.7",
    "chai": "^4.2.0",
    "coveralls": "^3.1.1",
    "cross-env": "^7.0.3",
    "mocha": "^6.2.2",
    "nyc": "^15.0.0",
    "standard": "^14.3.1"
  },
  "workspaces": [
    "test/babel-8"
  ],
  "scripts": {
    "coverage": "nyc report --reporter=text-lcov | coveralls",
    "lint": "standard",
    "build": "babel src --out-dir lib",
    "release": "yarn build",
    "test:unit": "cross-env NODE_ENV=test nyc --reporter=lcov --reporter=text mocha --timeout 5000 test/*.js",
    "test": "yarn lint && yarn build && yarn test:unit",
    "prepublishOnly": "yarn test"
  },
  "standard": {
    "ignore": [
      "fixtures/*.js"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pkg-nec/babel-plugin-istanbul.git"
  },
  "keywords": [
    "babel",
    "babel-plugin",
    "istanbul",
    "coverage",
    "code-coverage",
    "instrumentation",
    "nyc",
    "javascript"
  ],
  "nyc": {
    "include": [
      "src/*.js",
      "fixtures/should-cover.js"
    ],
    "require": [
      "@babel/register"
    ],
    "sourceMap": false,
    "instrument": false
  },
  "bugs": {
    "url": "https://github.com/pkg-nec/babel-plugin-istanbul/issues"
  },
  "homepage": "https://github.com/pkg-nec/babel-plugin-istanbul#readme",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "yarn@4.18.0"
}
